<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BlindIt</AssemblyName>
    <RootNamespace>BlindIt</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- Keep these in step with the version in MelonInfo (Probe.cs), which is
         what MelonLoader shows the player and what the release zip is named for. -->
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <!-- Deterministic=false so every build gets a fresh MVID/timestamp,
         which the probe reports as its build stamp. -->
    <Deterministic>false</Deterministic>
    <!-- Source files are UTF-8 without a BOM and contain accented literals for
         the speech accent test. Stated explicitly so the compiler never falls
         back to the system code page and mangles them. -->
    <CodePage>65001</CodePage>
    <!-- Where your copy of the game is installed. The references below are the
         Il2Cpp proxy assemblies MelonLoader generates from the game's own code,
         so they are never committed: each developer builds against their own
         install. Override without editing this file:
             dotnet build -p:GameDir="D:\Steam\steamapps\common\Bop It!"
         or set a GameDir environment variable. -->
    <GameDir Condition="'$(GameDir)' == ''">L:\SteamLibrary\steamapps\common\Bop It!</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(GameDir)\MelonLoader\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\MelonLoader\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Il2Cpp proxy assemblies, generated by MelonLoader on first launch from
         the game's own metadata. They are the compile-time contract for every
         game and engine type the mod touches: if a name here does not exist in
         THIS build of the game, the build fails instead of the game crashing.
         Regenerated by the loader after a game update, which is what turns a
         breaking update into a build error. -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Legacy UnityEngine.Input, used only as the dump-key fallback. Present in
         this build; the call is isolated so an absent module cannot kill a thread. -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game's own classes (SettingsRow and friends) live in the Il2Cpp
         namespace of this proxy. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Unity's localization package, which owns the game's language setting.
         Verified present in THIS build, and the three members the mod reads
         (LocalizationSettings.SelectedLocale, Locale.Identifier,
         LocaleIdentifier.Code) were confirmed by reading the proxy's metadata
         directly on 2026-10-01. Needed so Blind it! speaks the language the
         player set in the game rather than guessing from Windows. -->
    <Reference Include="Unity.Localization">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
